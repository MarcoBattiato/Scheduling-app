{
  // Both packages live in this one venv (calendar_store is installed into it
  // as an editable path dependency), so it can run everything in the repo.
  // If VS Code has already remembered a different interpreter, this setting is
  // ignored — run "Python: Select Interpreter" once and pick this path.
  "python.defaultInterpreterPath": "${workspaceFolder}/scheduling_engine/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "scheduling_engine/tests",
    "calendar_store/tests"
  ]
}
