{
  // "python" is pinned on every configuration on purpose. Without it these
  // run under whichever interpreter VS Code happens to have selected, and the
  // failure mode is silent: "No module named mock_ui", printed to a terminal
  // that closes, which reads as the server crashing on startup.
  //
  // The first configuration does NOT depend on which file is open — pick it
  // from the dropdown at the top of the Run and Debug panel, then press F5.
  // The Playground ones run "${file}", i.e. whichever .json you are looking at.

  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mock UI: start the server",
      "type": "debugpy",
      "request": "launch",
      "module": "mock_ui",
      "args": [
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/mock_ui",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/scheduling_engine/.venv/bin/python"
    },
    {
      "name": "Playground: run the JSON I have open",
      "type": "debugpy",
      "request": "launch",
      "module": "scheduling_engine.playground",
      "args": [
        "${file}",
        "--open"
      ],
      "cwd": "${workspaceFolder}/scheduling_engine",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/scheduling_engine/.venv/bin/python"
    },
    {
      "name": "Playground: compare alpha 0 / 0.5 / 1",
      "type": "debugpy",
      "request": "launch",
      "module": "scheduling_engine.playground",
      "args": [
        "${file}",
        "--alpha",
        "0,0.5,1",
        "--open"
      ],
      "cwd": "${workspaceFolder}/scheduling_engine",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/scheduling_engine/.venv/bin/python"
    },
    {
      "name": "Playground: examples/scenario.json",
      "type": "debugpy",
      "request": "launch",
      "module": "scheduling_engine.playground",
      "args": [
        "${workspaceFolder}/scheduling_engine/examples/scenario.json",
        "--open"
      ],
      "cwd": "${workspaceFolder}/scheduling_engine",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/scheduling_engine/.venv/bin/python"
    }
  ]
}
